{
  "name": "@turism/ai-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worker de IA: consome ai_jobs (Postgres/pg-boss) para jobs longos (roteiros em PDF grandes, OCR em lote, sugestões) e expõe healthcheck.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@supabase/supabase-js": "^2.49.1",
    "fastify": "^5.2.1",
    "pg-boss": "^10.1.6",
    "zod": "^3.25.0"
  },
  "devDependencies": { "@types/node": "^22.13.1", "tsx": "^4.19.2", "typescript": "^5.7.3", "vitest": "^3.0.5" }
}
